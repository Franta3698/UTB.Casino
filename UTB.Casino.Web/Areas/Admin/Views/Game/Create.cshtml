@model Game

@{
    ViewData["Title"] = "Game - Create";
}
<h1>@ViewData["Title"]</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label" asp-for="Name"></label>
        <input class="form-control" asp-for="Name">
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Description"></label>
        <input class="form-control" asp-for="Description">
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Cost"></label>
        <input class="form-control" asp-for="Cost">
        <span asp-validation-for="Cost" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Picture">Image Source</label>
        <input class="form-control" asp-for="Picture">
        <span asp-validation-for="Picture" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="AltPicture"></label>
        <input class="form-control" asp-for="AltPicture">
        <span asp-validation-for="AltPicture" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Submit</button>
</form>
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
