@using UTB.Casino.Domain.Entities
@model IList<Game>
@{
    ViewData["Title"] = "Game Administration";
}
<h1>@ViewData["Title"]</h1>
@{
    if (Model != null && Model.Count > 0)
    {
        <table class="table">
            <thead>
            <tr>
                <th scope="col"> @nameof(Game.Id)</th>
                <th scope="col"> @nameof(Game.Name)</th>
                <th scope="col"> @nameof(Game.Description)</th>
                <th scope="col"> @nameof(Game.Cost)</th>
                <th scope="col"> @nameof(Game.Picture)</th>
                <th scope="col"> @nameof(Game.AltPicture)</th>
                <th scope="col"> Delete</th>

            </tr>
            </thead>
            <tbody>
            @foreach (var game in Model)
            {
                <tr>
                    <th scope="row">@game.Id</th>
                    <td>@game.Name</td>
                    <td>@game.Description</td>
                    <td>@game.Cost</td>
                    <td>@game.Picture</td>
                    <td>@game.AltPicture</td>
                    <td>
                        <form asp-action="Delete" asp-route-id="@game.Id" method="post">
                            <button type="submit" class="btn btn-primary">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <p>Game table is empty!</p>
    }
}
@section Scripts
{
    <script src="~/js/dialogs.js"></script>
}